rules_version = '2';

// Reglas de seguridad de OptiLink.
//
// Publicarlas con:  firebase deploy --only firestore:rules
// (reemplazan las reglas que tenga el proyecto en ese momento).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // Administrador: su perfil tiene role == 'admin'.
    function isAdmin() {
      return signedIn()
        && exists(profilePath())
        && get(profilePath()).data.role == 'admin';
    }

    // Óptica aprobada por el distribuidor.
    function isApproved() {
      return signedIn()
        && exists(profilePath())
        && get(profilePath()).data.status == 'aprobado';
    }

    // Perfiles. Cada cuenta crea el suyo como óptica pendiente y puede editar
    // sus datos, pero no su rol ni su estado: eso solo lo cambia un
    // administrador. El primer administrador se crea desde la consola.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'optica'
        && request.resource.data.status == 'pendiente';

      allow update: if isAdmin()
        || (signedIn()
            && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status);

      allow delete: if false;
    }

    // Catálogo: lo leen las ópticas aprobadas y lo administra el distribuidor.
    match /products/{productId} {
      allow read: if isApproved() || isAdmin();
      allow write: if isAdmin();
    }

    // Pedidos: una óptica aprobada crea los suyos y cada óptica lee solo los
    // suyos. El distribuidor los lee todos y es el único que cambia su estado.
    match /orders/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if isApproved()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'Pendiente'
        && request.resource.data.orderDate == request.time
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount >= 0;

      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
