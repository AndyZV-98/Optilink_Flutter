rules_version = '2';

// Reglas de seguridad de OptiLink.
//
// Publicarlas con:  firebase deploy --only firestore:rules
// (reemplazan las reglas que tenga el proyecto en ese momento).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Catálogo: cualquier óptica con sesión lo puede leer. Los productos se
    // administran desde la consola de Firebase (la consola no pasa por estas
    // reglas), así que la app no puede modificarlos.
    match /products/{productId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Pedidos: cada óptica crea y lee solo los suyos. El estado lo cambia el
    // distribuidor desde la consola; la app no puede editar ni borrar pedidos.
    match /orders/{orderId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'Pendiente'
        && request.resource.data.orderDate == request.time
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount >= 0;

      allow update, delete: if false;
    }
  }
}
